{
  "name": "vscode-psp-toolkit",
  "displayName": "PSP Dev Studio (PlayStation Portable)",
  "description": "Cross-platform build, automated toolchain diagnostics, and instant PPSSPP runner for PSP homebrew in C, SDL2, Rust, and Zig.",
  "version": "1.0.0",
  "publisher": "robfernan",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "icon": "media/icon.jpg",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "psp.runPPSSPP",
        "title": "PSP: Run in PPSSPP",
        "icon": "$(play)"
      },
      {
        "command": "psp.openLivePreview",
        "title": "PSP: Open In-IDE Live Preview",
        "icon": "$(device-mobile)"
      },
      {
        "command": "psp.openDashboard",
        "title": "PSP: Open Dev Studio Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "psp.installToolchain",
        "title": "PSP: Auto-Install PPSSPP & Tools",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "psp.openLivePreview",
          "group": "navigation@10"
        },
        {
          "command": "psp.runPPSSPP",
          "group": "navigation@11"
        },
        {
          "command": "psp.openDashboard",
          "group": "navigation@12"
        }
      ],
      "editor/title/run": [
        {
          "command": "psp.runPPSSPP",
          "group": "navigation@1"
        }
      ]
    }
  }
}
